<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- شعار -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zozety Love 💖"
                    android:textSize="32sp"
                    android:textColor="@color/primary_color"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تطبيق الحب الخاص بنا"
                    android:textSize="16sp"
                    android:textColor="@color/text_light"/>
            </LinearLayout>

            <!-- رسالة الحب -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/card_background">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💌 رسالة حب اليوم"
                        android:textSize="18sp"
                        android:textColor="@color/primary_color"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/tvLoveMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="جارِ تحميل رسالة حب..."
                        android:textSize="20sp"
                        android:textColor="@color/text_color"
                        android:lineSpacingExtra="8dp"
                        android:gravity="center"
                        android:padding="16dp"
                        android:background="@color/background_color"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnNewMessage"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/new_message"
                            android:textSize="16sp"
                            android:backgroundTint="@color/primary_color"/>

                        <Button
                            android:id="@+id/btnSpeak"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/speak_message"
                            android:textSize="16sp"
                            android:backgroundTint="@color/accent_color"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- الصورة -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📸 صور حبنا"
                        android:textSize="18sp"
                        android:textColor="@color/primary_color"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <ImageView
                        android:id="@+id/ivLoveImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:src="@drawable/ic_heart"
                        android:scaleType="centerCrop"
                        android:layout_marginBottom="12dp"
                        android:background="@color/background_color"/>

                    <Button
                        android:id="@+id/btnAddImage"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/add_image"
                        android:textSize="16sp"
                        android:backgroundTint="@color/primary_color"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- الموسيقى -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵 موسيقى الحب"
                        android:textSize="18sp"
                        android:textColor="@color/primary_color"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnPlayMusic"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/play_music"
                            android:textSize="16sp"
                            android:backgroundTint="@color/primary_color"/>

                        <Button
                            android:id="@+id/btnStopMusic"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/stop_music"
                            android:textSize="16sp"
                            android:backgroundTint="@color/accent_color"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- أزرار التحكم -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/settings"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btnSendLove"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/send_love"
                    android:textSize="16sp"
                    android:backgroundTint="@color/primary_color"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <!-- تذييل -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="خاص بـ Zozety Love 👫"
                android:textSize="12sp"
                android:textColor="@color/text_light"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
